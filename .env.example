VITE_DEV=true

VITE_APP_NAME=AIPT
VITE_APP_SUBTITLE=accounts | inventory | payroll | tax
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=AIPT is a web application for managing accounts inventory payroll.
VITE_APP_AUTHOR=aipt-team
# VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=https://aipt-api.local/api

# Vite build configuration
VITE_BASE_URL=/
VITE_API_SECURE=false

# Backend URL for the Vite dev server proxy (dev only, no /api suffix)
VITE_BACKEND_URL=http://localhost:8000

# Social login URLs (require configured OAuth credentials to work)
VITE_GOOGLE_LOGIN_URL=#
VITE_GITHUB_LOGIN_URL=#
VITE_MICROSOFT_LOGIN_URL=#

# Reverb WebSocket (Laravel Broadcasting)
VITE_REVERB_APP_KEY=af749dfcf9c0012a6a40a3fd24650e4a
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Auth token storage driver: localStorage, sessionStorage, or cookie
VITE_AUTH_STORAGE=localStorage
# Absolute URL of the API's channel-auth endpoint (`/broadcasting/auth`, NOT
# under `/api`). Defaults to the API origin derived from VITE_API_BASE_URL
# (e.g. https://api.sharmahardware.co.in/api -> .../broadcasting/auth). Only
# set this to override the derived default.
# VITE_REVERB_AUTH_ENDPOINT=https://api.sharmahardware.co.in/broadcasting/auth