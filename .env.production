# Production build config for https://sharmahardware.co.in (API on the
# api.sharmahardware.co.in subdomain). Loaded by `vite build` (mode=production).
VITE_DEV=false

VITE_APP_NAME=Sharma
VITE_APP_SUBTITLE=Manage your accounts inventory payroll with ease.
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sharma is a web application for managing accounts inventory payroll.
VITE_APP_AUTHOR=sharma-team

# API base — absolute URL of the Laravel API (must end with /api)
VITE_API_BASE_URL=https://api.sharmahardware.co.in/api
# Backend URL for the Vite dev/preview proxy (no /api suffix)
VITE_BACKEND_URL=https://api.sharmahardware.co.in

# Vite build configuration
VITE_BASE_URL=/
VITE_API_SECURE=true

# Auth token storage driver (cookie is NOT usable — the JWT cookie is httpOnly)
VITE_AUTH_STORAGE=localStorage

# Reverb WebSocket (Laravel Broadcasting) — must match the backend REVERB_* env
VITE_REVERB_APP_KEY=af749dfcf9c0012a6a40a3fd24650e4a
VITE_REVERB_HOST=api.sharmahardware.co.in
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
# Laravel Echo channel-auth endpoint (NOT under /api). Also derived from
# VITE_API_BASE_URL at runtime, but pinned here explicitly for production.
VITE_REVERB_AUTH_ENDPOINT=https://api.sharmahardware.co.in/broadcasting/auth

# Social login URLs are disabled (no OAuth credentials configured) — the app
# falls back to '#' which disables them. Enable by uncommenting and setting:
# VITE_GOOGLE_LOGIN_URL=
# VITE_GITHUB_LOGIN_URL=
# VITE_MICROSOFT_LOGIN_URL=
